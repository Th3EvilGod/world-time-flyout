<Project Sdk="Microsoft.NET.Sdk">
  <!-- Platform-neutral logic: time math, city catalog, formatting, settings.
       No Windows dependencies so it is unit-tested on any OS. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace>WorldTime.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NodaTime" Version="3.3.7" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Data\catalog.tsv.gz" LogicalName="WorldTime.Core.catalog.tsv.gz" />
  </ItemGroup>
</Project>
